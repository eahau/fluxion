{
  "extends": "./.umi/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@@/*": [".umi/*"],
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*",
    "config/**/*",
    ".umi/**/*"
  ]
}
